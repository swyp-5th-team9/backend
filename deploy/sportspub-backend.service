[Unit]
Description=Sportspub Backend (Spring Boot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sportspub
Group=sportspub
WorkingDirectory=/opt/sportspub
EnvironmentFile=/etc/sportspub/sportspub.env
ExecStart=/usr/bin/java -Xms256m -Xmx512m -jar /opt/sportspub/app.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/sportspub/app.log
StandardError=append:/var/log/sportspub/app.log

# 보안 강화
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
