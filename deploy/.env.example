# systemd unit 이 EnvironmentFile 로 이 경로를 읽어 spring 환경 변수로 주입한다.
# 파일 권한은 640, 소유자는 root:moball.

# --- DB (RDS) ---
DB_URL=jdbc:postgresql://<RDS_ENDPOINT>:5432/sportspub_db
DB_USERNAME=moball
DB_PASSWORD=<강력 패스워드>

# --- JWT (256bit 이상 랜덤, base64 권장) ---
# 생성 예: openssl rand -base64 64
JWT_SECRET=<랜덤 시크릿>

# --- OAuth (카카오/네이버 콘솔에서 발급) ---
KAKAO_CLIENT_ID=<카카오 REST API 키>
KAKAO_CLIENT_SECRET=<카카오 client secret>
NAVER_CLIENT_ID=<네이버 client id>
NAVER_CLIENT_SECRET=<네이버 client secret>

# --- Slack (제보 등록 알림 — Incoming Webhook URL) ---
SLACK_REPORT_WEBHOOK_URL=<Slack Incoming Webhook URL>

# --- FCM (경기 알림 푸시) ---
# Firebase Console > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 JSON
# systemd EnvironmentFile 은 여러 줄 JSON 이 까다로우므로 Base64 권장:
#   base64 -w0 service-account.json
FCM_ENABLED=false
FCM_CREDENTIALS_BASE64=
# 또는 원문 JSON (한 줄): FCM_CREDENTIALS_JSON={"type":"service_account",...}

# --- Spring profile ---
SPRING_PROFILES_ACTIVE=prod
