# 운영 EC2 의 /etc/moball/moball.env 로 복사 후 값 채워서 사용.
# systemd unit 이 EnvironmentFile 로 이 경로를 읽어 spring 환경 변수로 주입한다.
# 파일 권한은 640, 소유자는 root:moball.

# --- DB (RDS) ---
DB_URL=jdbc:postgresql://<RDS_ENDPOINT>:5432/sportspub_db
DB_USERNAME=moball
DB_PASSWORD=<강력 패스워드>

# --- JWT (256bit 이상 랜덤, base64 권장) ---
# 생성 예: openssl rand -base64 64
JWT_SECRET=<랜덤 시크릿>

# --- OAuth (카카오/네이버 콘솔에서 발급) ---
KAKAO_CLIENT_ID=<카카오 REST API 키>
KAKAO_CLIENT_SECRET=<카카오 client secret>
NAVER_CLIENT_ID=<네이버 client id>
NAVER_CLIENT_SECRET=<네이버 client secret>

# --- Spring profile ---
SPRING_PROFILES_ACTIVE=prod
