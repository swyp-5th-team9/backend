# 이 파일을 application-local.yml 로 복사한 뒤 시크릿 값을 채워 사용하세요.
# application-local.yml 은 .gitignore 에 등록되어 있어 커밋되지 않습니다.

spring:
  datasource:
    url: ${DB_URL:jdbc:postgresql://localhost:5432/sportspub_db}
    username: ${DB_USERNAME:sportspub}
    password: ${DB_PASSWORD:sportspub}
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        format_sql: true
        dialect: org.hibernate.dialect.PostgreSQLDialect
        jdbc:
          time_zone: Asia/Seoul
    show-sql: true

  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: false
    validate-on-migrate: true

  security:
    oauth2:
      client:
        registration:
          kakao:
            client-id: ${KAKAO_CLIENT_ID:CHANGE_ME}
            client-secret: ${KAKAO_CLIENT_SECRET:CHANGE_ME}
            redirect-uri: "{baseUrl}/login/oauth2/code/{registrationId}"
            authorization-grant-type: authorization_code
            client-authentication-method: client_secret_post
            scope:
              - profile_nickname
              - account_email
            client-name: Kakao
          naver:
            client-id: ${NAVER_CLIENT_ID:CHANGE_ME}
            client-secret: ${NAVER_CLIENT_SECRET:CHANGE_ME}
            redirect-uri: "{baseUrl}/login/oauth2/code/{registrationId}"
            authorization-grant-type: authorization_code
            scope:
              - nickname
              - email
            client-name: Naver
        provider:
          kakao:
            authorization-uri: https://kauth.kakao.com/oauth/authorize
            token-uri: https://kauth.kakao.com/oauth/token
            user-info-uri: https://kapi.kakao.com/v2/user/me
            user-name-attribute: id
          naver:
            authorization-uri: https://nid.naver.com/oauth2.0/authorize
            token-uri: https://nid.naver.com/oauth2.0/token
            user-info-uri: https://openapi.naver.com/v1/nid/me
            user-name-attribute: response

app:
  jwt:
    secret: ${JWT_SECRET:change-me-to-a-256bit-random-string-base64-encoded}
    access-ttl-seconds: 1800        # 30분
    refresh-ttl-seconds: 1209600    # 14일
  deeplink:
    scheme: sportspub://auth/callback
  # AWS S3 — .env: S3_BUCKET, AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
  # TODO [AWS]: reports/* GetObject 허용 전까지 저장 URL 브라우저 접근 시 AccessDenied (ReportS3StorageService 참고)
  s3:
    bucket: ${S3_BUCKET:}
    region: ${AWS_REGION:ap-northeast-2}
    access-key: ${AWS_ACCESS_KEY_ID:}
    secret-key: ${AWS_SECRET_ACCESS_KEY:}

logging:
  level:
    com.swift.sportspub: DEBUG
    org.hibernate.SQL: DEBUG
